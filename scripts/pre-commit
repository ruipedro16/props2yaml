#!/bin/env bash

set -e

# Ensure we're running from the repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Running pre-commit hook in $(pwd) ..."

# Only check staged Rust files
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -z "$STAGED_RS_FILES" ]; then
    echo "No Rust files staged, skipping checks"
    exit 0
fi

echo "Formatting code ..."
cargo fmt --all
if [ $? -ne 0 ]; then
    echo "cargo fmt failed"
    exit 1
fi

# Re-add formatted files
echo "$STAGED_RS_FILES" | xargs git add

echo "Running tests ..."
cargo test

echo "Running Clippy ..."
cargo clippy --all-targets --all-features -- -D warnings

echo "✅ Finished running pre-commit hook"
